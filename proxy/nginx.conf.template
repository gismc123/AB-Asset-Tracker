# Generated at container start by 40-mortgage-setup.sh.
#
# Everything goes to stock Actual untouched, except:
#   /mortgage-addon/*  and  /mortgage-api/*   -> the mortgage backend
#   Actual's HTML pages get one extra tag before </head>:
#     <script src="/mortgage-addon/inject.js" defer></script>
# Actual's CSP allows scripts from 'self', and this is same-origin, so no
# Actual setting has to change.

# Docker's internal DNS: re-resolve service names so Actual updates don't break routing.
resolver 127.0.0.11 valid=10s ipv6=off;

map $http_upgrade $connection_upgrade {
  default upgrade;
  ''      close;
}

server {
  listen 8443 ssl;
  http2 on;
  server_name _;

  ssl_certificate     ${TLS_CERT};
  ssl_certificate_key ${TLS_KEY};
  ssl_protocols TLSv1.2 TLSv1.3;

  # Budget uploads (sync files) can be large.
  client_max_body_size 200m;

  set $actual_upstream  ${ACTUAL_UPSTREAM_URL};
  set $mortgage_backend ${MORTGAGE_BACKEND_URL};

  proxy_http_version 1.1;
  proxy_set_header Host              $http_host;
  proxy_set_header X-Real-IP         $remote_addr;
  proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
  proxy_set_header X-Forwarded-Proto https;

  location ^~ /mortgage-addon/ {
    proxy_pass $mortgage_backend;
  }

  location ^~ /mortgage-api/ {
    proxy_pass $mortgage_backend;
    proxy_read_timeout 120s;
  }

  location / {
    proxy_pass $actual_upstream;
    # Actual's own cert is often self-signed; traffic stays on this host.
    proxy_ssl_verify off;
    proxy_ssl_server_name on;

    proxy_set_header Upgrade    $http_upgrade;
    proxy_set_header Connection $connection_upgrade;
    proxy_read_timeout 300s;

    # sub_filter can only edit uncompressed responses.
    proxy_set_header Accept-Encoding "";
    sub_filter '</head>' '<script src="/mortgage-addon/inject.js" defer></script></head>';
    sub_filter_once on;
    sub_filter_last_modified on;
  }
}
