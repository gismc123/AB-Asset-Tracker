# Generated at container start by 40-asset-tracker-setup.sh.
#
# Everything goes to stock Actual untouched, except:
#   /asset-tracker-addon/*  and  /asset-tracker-api/*   -> the tracker backend
#   Actual's HTML pages get one extra tag before </head>:
#     <script src="/asset-tracker-addon/inject.js" defer></script>
# Actual's CSP allows scripts from 'self', and this is same-origin, so no
# Actual setting has to change.

# Docker's internal DNS: re-resolve service names so Actual updates don't break routing.
resolver 127.0.0.11 valid=10s ipv6=off;

# Actual's responses arrive uncompressed (sub_filter needs that, see below),
# so compress them here on the way out. text/html is always included.
gzip on;
gzip_proxied any;
gzip_vary on;
gzip_min_length 1024;
gzip_types text/css text/plain application/javascript application/json application/wasm image/svg+xml;

map $http_upgrade $connection_upgrade {
  default upgrade;
  ''      close;
}

# With PROXY_TLS=off, how the browser reached whatever is in front of us
# (a Cloudflare Tunnel sends https), or this connection's scheme if not said.
map $http_x_forwarded_proto $forwarded_proto {
  default $http_x_forwarded_proto;
  ''      $scheme;
}

server {
  ${LISTEN}
  server_name _;

  # Budget uploads (sync files) can be large.
  client_max_body_size 200m;

  set $actual_upstream  ${ACTUAL_UPSTREAM_URL};
  set $tracker_backend ${TRACKER_BACKEND_URL};

  # Every proxy_set_header lives here: a location that sets even one of its
  # own inherits none of these.
  proxy_http_version 1.1;
  proxy_set_header Host              $http_host;
  proxy_set_header X-Real-IP         $remote_addr;
  proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
  proxy_set_header X-Forwarded-Proto ${FORWARDED_PROTO};
  proxy_set_header Upgrade           $http_upgrade;
  proxy_set_header Connection        $connection_upgrade;
  # sub_filter can only edit uncompressed responses.
  proxy_set_header Accept-Encoding   "";

  location ^~ /asset-tracker-addon/ {
    proxy_pass $tracker_backend;
  }

  location ^~ /asset-tracker-api/ {
    proxy_pass $tracker_backend;
    proxy_read_timeout 120s;
  }

  location / {
    proxy_pass $actual_upstream;
    # Actual's own cert is often self-signed; traffic stays on this host.
    proxy_ssl_verify off;
    proxy_ssl_server_name on;
    proxy_read_timeout 300s;

    sub_filter '</head>' '<script src="/asset-tracker-addon/inject.js" defer></script></head>';
    sub_filter_once on;
    sub_filter_last_modified on;
  }
}
