{
  "name": "ab-asset-tracker",
  "version": "0.2.0",
  "description": "Loan and asset tracker for a stock Actual Budget server: mortgages, car and personal loans, amortization, equity and monthly reconciliation. Read-only toward Actual.",
  "license": "MIT",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "build": "npm run build:server && npm run build:ui",
    "build:server": "tsc -p tsconfig.build.json",
    "build:ui": "node scripts/build-ui.mjs",
    "start": "node dist/server/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@actual-app/api": "26.10.0",
    "better-sqlite3": "^13.0.3",
    "express": "^5.1.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/express": "^5.0.3",
    "@types/node": "^22.15.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@types/supertest": "^6.0.3",
    "esbuild": "^0.28.2",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "supertest": "^7.1.0",
    "typescript": "~5.9.2",
    "vitest": "^5.0.5"
  }
}
