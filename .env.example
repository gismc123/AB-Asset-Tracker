# Copy this file to .env and fill it in. .env is gitignored.

# --- Which setup -------------------------------------------------------------
# Docker Compose reads this, so every command in this folder is just
# `docker compose ...` with no -f flag.
#   compose.existing-actual.yml   A: in front of an Actual you already run (most people)
#   docker-compose.yml            B: fresh install, Actual and the add-on together
COMPOSE_FILE=compose.existing-actual.yml
#
# There are intentionally NO defaults for the Actual connection. The
# backend refuses to start if ACTUAL_SERVER_URL or ACTUAL_PASSWORD is empty.
# Point these at a TEST instance while you are trying the tracker out.

# --- Actual connection (used by the backend, read-only) ----------------
# URL the backend uses to reach the Actual server *from inside Docker*.
#   Bundled stack (docker-compose.yml):              http://actual:5006
#   Existing Actual on this host, served over HTTPS:  https://actual:5006
#     (compose.existing-actual.yml maps the name "actual" to the host)
ACTUAL_SERVER_URL=
# The Actual server password (the one you type on Actual's login screen).
ACTUAL_PASSWORD=
# Budget "Sync ID": Actual -> Settings -> Show advanced settings -> Sync ID.
ACTUAL_SYNC_ID=
# Only if the budget uses end-to-end encryption. Otherwise leave empty.
ACTUAL_BUDGET_PASSWORD=
# If Actual uses a self-signed certificate, the path *inside the backend
# container* to that certificate so the backend can verify it.
# docker compose mounts ACTUAL_CERT_DIR at /certs, so this is usually
# /certs/tls.crt. Leave empty for the bundled stack.
ACTUAL_CA_CERT=

# --- Proxy ---------------------------------------------------------------
# Where the proxy forwards normal Actual traffic (inside Docker).
# Same value as ACTUAL_SERVER_URL in almost every setup.
ACTUAL_UPSTREAM=
# Port you open in the browser to get Actual *with* the Loans item.
# Prefix an address to listen only there, e.g. 127.0.0.1:5007 when
# cloudflared runs on this machine and nothing else should reach the port.
PROXY_PORT=5007
# on:  the proxy serves HTTPS itself (self-signed, or the certificate below).
# off: plain HTTP, for when a Cloudflare Tunnel or your own reverse proxy
#      already handles HTTPS. Then open Actual only through that HTTPS address:
#      Actual doesn't run on plain http:// except on localhost.
PROXY_TLS=on
# Folder on the host holding tls.crt and tls.key for the proxy (and the CA
# cert above). If the folder has no tls.crt/tls.key the proxy generates a
# self-signed pair into it on first start.
ACTUAL_CERT_DIR=./certs
# Certificate and key file names inside ACTUAL_CERT_DIR. Point these at a
# real certificate (for example fullchain.pem / privkey.pem) to avoid the
# browser warning. Defaults: tls.crt and tls.key.
TLS_CERT_FILE=tls.crt
TLS_KEY_FILE=tls.key

# --- Bundled stack only ----------------------------------------------------
# Host folder for the stock Actual server's data (docker-compose.yml only).
ACTUAL_DATA_DIR=./actual-data

# --- Read-only summary endpoint (for a future MagicMirror module) --------
# Leave empty to keep the endpoint disabled. When set, callers send the
# header "Authorization: Bearer <value>". Use a long random value, for
# example from `openssl rand -hex 24`.
SUMMARY_TOKEN=

# --- Bundled stack: which Actual image to run ------------------------------
# Default: docker.io/actualbudget/actual-server:latest. Pin a tag here
# (for example docker.io/actualbudget/actual-server:26.10.0) to update on
# your own schedule.
ACTUAL_IMAGE=

# --- Misc ------------------------------------------------------------------
# Port the backend listens on inside the Docker network. Only change it if
# 3100 clashes with something; the proxy follows automatically.
BACKEND_PORT=3100
# Timezone used to decide "today" for the schedule, as a tz database name
# such as Europe/Berlin or America/Denver. Default: UTC.
TZ=Etc/UTC
